      "parameters": {
        "html": "<!doctype html>\n<html>\n<head>\n  <meta charset=\"utf-8\">\n  <style>\n    .btn-pay {\n      display: inline-block;\n      margin-top: 24px;\n      padding: 12px 24px;\n      background: #16a34a;\n      color: #ffffff;\n      text-decoration: none;\n      border-radius: 6px;\n      font-weight: bold;\n      font-size: 14px;\n    }\n\n    .btn-pay:hover {\n      background: #15803d;\n    }\n\n    .btn-wrapper {\n      text-align: left;\n    }\n\n    body {\n      font-family: Arial, sans-serif;\n      font-size: 12px;\n    }\n\n    .container {\n      width: 720px;\n      margin: auto;\n    }\n\n    h1 {\n      margin-bottom: 4px;\n    }\n\n    table {\n      width: 100%;\n      border-collapse: collapse;\n      margin-top: 16px;\n    }\n\n    th,\n    td {\n      border-bottom: 1px solid #ddd;\n      padding: 8px;\n    }\n\n    th {\n      background: #f5f5f5;\n    }\n\n    .right {\n      text-align: right;\n    }\n\n    .total {\n      font-weight: bold;\n      font-size: 14px;\n    }\n  </style>\n</head>\n\n<body>\n  <div class=\"container\">\n    <h1>Invoice</h1>\n\n    <p>\n      <strong>Invoice #:</strong>\n      {{ $('prepare data').item.json.invoice_number }}\n      <br>\n      <strong>Date:</strong>\n{{ DateTime.fromISO($('Create Invoice').item.json.data.expiredAt).minus({ days: 1 }).toLocaleString(DateTime.DATETIME_MED) }}\n    </p>\n\n    <table>\n      <thead>\n        <tr>\n          <th>#</th>\n          <th>Item</th>\n          <th class=\"right\">Price</th>\n          <th class=\"right\">Qty</th>\n          <th class=\"right\">Total</th>\n        </tr>\n      </thead>\n\n      <tbody>\n        {{ $('prepare data').item.json.rowsHtml }}\n      </tbody>\n\n      <tfoot>\n        <tr>\n          <td colspan=\"4\" class=\"right\">Subtotal</td>\n          <td class=\"right\">\n            Rp {{ $('prepare data').item.json.subtotal.format('id-ID') }}\n          </td>\n        </tr>\n\n        <tr>\n          <td colspan=\"4\" class=\"right total\">Total</td>\n          <td class=\"right total\">\n            Rp {{ $('prepare data').item.json.total_amount.format('id-ID') }}\n          </td>\n        </tr>\n      </tfoot>\n    </table>\n\n    <div class=\"btn-wrapper\">\n      <a\n        class=\"btn-pay\"\n        href=\"{{ $('Create Invoice').item.json.data.link }}\"\n        target=\"_blank\"\n      >\n        💳 Bayar\n      </a>\n    </div>\n  </div>\n</body>\n</html>\n"
