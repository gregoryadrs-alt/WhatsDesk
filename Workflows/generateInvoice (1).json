    {
      "parameters": {
        "jsCode": "const item = $('prepare data').first().json;\n// Konversi array items ke format Mayar v2 (description, quantity, rate)\nconst mayarV2Items = (item.mayar_items || []).map((it) => ({\n  description: it.name,\n  quantity: Number(it.quantity) || 1,\n  rate: Number(it.price) || 0\n}));\n\n// Pastikan nomor HP diawali 08 (jika format sebelumnya 628...)\nlet mobile = (item.phone_number || \"\").toString().trim();\nif (mobile.startsWith(\"62\")) {\n  mobile = \"0\" + mobile.slice(2);\n}\n\nreturn [\n  {\n    json: {\n      ...item,\n      phone_number_formatted: mobile,\n      mayar_v2_items: mayarV2Items\n    }\n  }\n];"
